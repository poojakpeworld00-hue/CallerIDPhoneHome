<?xml version="1.0" encoding="utf-8"?>
<!-- Full-screen loader while an ad for an app tap is fetched: the tapped app's icon and name, so
     the wait reads as "opening that app", not as the launcher hanging. See AppLaunchLoader. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:gravity="center"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/launchLoaderIcon"
        android:layout_width="@dimen/_64sdp"
        android:layout_height="@dimen/_64sdp"
        android:contentDescription="@null"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/launchLoaderName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_12sdp"
        android:fontFamily="@font/figtree_bold"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        android:paddingHorizontal="@dimen/_24sdp"
        android:textColor="@color/white"
        android:textSize="18sp" />

    <ProgressBar
        style="?android:attr/progressBarStyle"
        android:layout_width="@dimen/_32sdp"
        android:layout_height="@dimen/_32sdp"
        android:layout_marginTop="@dimen/_24sdp"
        android:indeterminate="true"
        android:indeterminateTint="@color/white" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_10sdp"
        android:fontFamily="@font/figtree_medium"
        android:text="@string/please_wait"
        android:textColor="@color/white" />

</LinearLayout>
