    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item
                    android:color="#FF0BD1FF"
                    android:offset="0" />
                <item
                    android:color="#FF0A95FF"
                    android:offset="0.5" />
                <item
                    android:color="#FF046DFF"
                    android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
