<?xml version="1.0" encoding="utf-8"?>
<!--
    Claude Design "CID03" tokens, light theme.

    The design declares these in OKLCH; the values here are the exact sRGB
    conversions. The neutral ramp and the shadows come from the Broadsheet
    design system (styles.css); everything else is declared on the page.
    Dark-theme overrides live in values-night/colors_cid.xml.
-->
<resources>
    <!-- green ramp -->
    <color name="cid_g_900">#FF082939</color>
    <color name="cid_g_800">#FF093F5C</color>
    <color name="cid_g_700">#FF0969A8</color>
    <color name="cid_g_600">#FF087AB6</color>
    <color name="cid_g_500">#FF0B94E0</color>
    <color name="cid_g_200">#FFADE2FF</color>
    <color name="cid_g_100">#FFD8EFFF</color>
    <color name="cid_g_050">#FFEEF8FF</color>

    <!-- accents -->
    <color name="cid_clay">#FFC76841</color>
    <color name="cid_clay_100">#FFFEE5DC</color>
    <color name="cid_clay_ink">#FF713319</color>
    <color name="cid_teal">#FF089AA2</color>
    <color name="cid_teal_100">#FFC9F3F7</color>
    <color name="cid_teal_ink">#FF004C4D</color>
    <color name="cid_amber">#FFB98833</color>
    <color name="cid_amber_100">#FFFAEAD3</color>
    <color name="cid_amber_ink">#FF664603</color>
    <color name="cid_on_accent">#FFFFFFFF</color>

    <!--
        Onboarding palette, sampled from the reference screens, with a values-night
        counterpart so both screens theme correctly.

        The roles are split rather than sharing one "ink", because they do NOT flip
        together. Page ink and the CTA invert with the theme; the shield mark stays a
        green mark; and the mock call screen inside the illustration stays dark in both
        themes, because it is a picture of a phone showing an incoming call — inverting
        it would read as a bug, not as dark mode.
    -->
    <color name="cid_onb_paper">#FFF1F2F3</color>
    <color name="cid_onb_ink">#FF082939</color>
    <color name="cid_onb_muted">#FF5C6C76</color>

    <color name="cid_onb_cta">#FF0969A8</color>
    <color name="cid_onb_on_cta">#FFFFFFFF</color>

    <color name="cid_onb_accent">#FF0969A8</color>
    <color name="cid_onb_on_accent">#FFFFFFFF</color>
    <color name="cid_onb_badge_disc">#FFFFFFFF</color>

    <color name="cid_onb_mark">#FF0969A8</color>
    <color name="cid_onb_on_mark">#FFFFFFFF</color>

    <color name="cid_onb_blob">#FFD8EFFF</color>
    <color name="cid_onb_card">#FFF4FAFF</color>
    <color name="cid_onb_card_stroke">#FFC9E5F9</color>
    <color name="cid_onb_tile">#FFD2EDFF</color>

    <!-- the mock call screen: identical in both themes -->
    <color name="cid_onb_mock">#FF082939</color>
    <color name="cid_onb_on_mock">#FFFFFFFF</color>
    <color name="cid_onb_mock_avatar">#FF687379</color>
    <color name="cid_onb_mock_chip">#FF093F5C</color>
    <color name="cid_onb_decline">#FFC0522D</color>

    <!-- Broadsheet neutrals -->
    <color name="cid_bg">#FFF3F2F2</color>
    <color name="cid_text">#FF201E1D</color>
    <color name="cid_neutral_100">#FFF8F4F4</color>
    <color name="cid_neutral_200">#FFEAE7E7</color>
    <color name="cid_neutral_300">#FFD7D3D3</color>
    <color name="cid_neutral_400">#FFBAB6B6</color>
    <color name="cid_neutral_600">#FF7D7979</color>
    <color name="cid_neutral_700">#FF605D5D</color>
</resources>
